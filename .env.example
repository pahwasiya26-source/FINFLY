# ==========================================================
# FINFLY Environment Configuration Template
# DO NOT commit real secrets or production keys to version control.
# ==========================================================

# ----------------------------------------------------------
# Supabase Configuration
# ----------------------------------------------------------
# Public URL and Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only Service Role Key (NEVER expose to browser / client code)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here-server-only

# ----------------------------------------------------------
# App Environment ('development' | 'production' | 'test')
# ----------------------------------------------------------
NEXT_PUBLIC_APP_ENV=development

# ----------------------------------------------------------
# LLM Providers (Optional for external LLM execution)
# ----------------------------------------------------------
# NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
